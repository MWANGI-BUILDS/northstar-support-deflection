# Example environment variables for the Support Deflection MVP
# Copy to .env and fill secrets before running in a real environment.

# Orders API (if unset, the connectors use in-repo demo mock data)
ORDERS_API_BASE_URL=
ORDERS_API_KEY=
ORDERS_API_KEY_HEADER_NAME=X-API-KEY
ORDERS_REQUEST_TIMEOUT=5

# Returns API (if separate)
RETURNS_API_BASE_URL=
RETURNS_API_KEY=

# Ticketing webhook (fallback). If unset, the connector will return a mock response.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_AUTH=

# Confidence threshold (0..1). If computed confidence < threshold, the bot asks for clarification and optionally creates a ticket.
CONFIDENCE_THRESHOLD=0.6

# Other settings
LOG_LEVEL=INFO
PORT=5000
